<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- MQTT / TCP communication with the Soleux modules and the cloud backend. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Reading the current network state before dialing MQTT / LAN connections. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- Resolving the active Wi-Fi interface for the LAN UDP discovery broadcast. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
    <!-- Enables multicast/broadcast on Wi-Fi so PDUs on the LAN are discovered 
         (Dart's RawDatagramSocket takes a WifiManager.MulticastLock for this). -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE"/>
    <!-- Android 13+ runtime permission for Wi-Fi based device discovery 
         ("Never for location"; the app derives no location from it). -->
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"/>
    <!-- Android 16+ runtime permission for direct LAN connections to the Soleux
         modules (UDP discovery, TCP command/status, local MQTT). Apps targeting
         SDK 36 are blocked from the local network without this grant. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK"/>
    <!-- Keeps the periodic module-status background worker scheduled across device reboots. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- Posting local notifications (Android 13+; requested at runtime). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Vibrating for incoming alert notifications on older Android releases. -->
    <uses-permission android:name="android.permission.VIBRATE"/>
    <!-- Keeps the device awake while surfacing notifications in Doze. -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <!-- Running the persistent module keep-alive as a foreground service
         (Android 9+; not needed for the background worker). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <!-- Android 15+ requires the service type permission for a specialUse
         foreground service (the continuous module monitoring service). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
    <!-- Opt-in flow (Settings -> Monitoring) asking the user to exempt the app
         from battery optimizations so the persistent socket/heartbeat keeps
         running indefinitely. Not requested automatically. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>
    <!-- Backup/restore external storage. The backup feature uses the system
         document pickers (Storage Access Framework) for both directions: the
         "Save as" dialog writes the backup file and the open dialog reads it.
         SAF runs out-of-process and grants per-file/per-tree access, so NO
         storage permission is required on any Android version (including
         scoped-storage Android 11+). The scoped declarations below only cover
         legacy raw-path access to shared storage on older releases: -->
    <!-- Android 10-12: reading non-media files from shared storage. Android 13+
         handles those through per-directory / file-native access instead. -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"/>
    <!-- Android 9 and earlier: writing to shared storage. Scoped storage
         (Android 10+) already allows shared-storage writes without it. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29"/>

    <application
        android:label="Soleux Device Manager"
        android:name="${applicationName}"
        android:icon="@mipmap/launcher_icon"
        android:enableOnBackInvokedCallback="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- Continuous module monitoring foreground service. Runs as
             specialUse (NOT dataSync, which Android 15+ caps at 6 h/day) so
             the persistent module sockets and the UDP heartbeat survive the
             app going to the background or the screen turning off. -->
        <service
            android:name=".ModuleKeepAliveService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <!-- Play Store requires this justification string (Policy
                 everywhere; required when declaring specialUse). During
                 development the service runs freely on device. -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Continuous LAN monitoring of the configured Soleux home-automation modules: keeps the persistent Control API / legacy AT status sockets and the UDP heartbeat monitor connected while the app is backgrounded or the screen is off, so module online/offline state and real-time status keep flowing." />
        </service>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
